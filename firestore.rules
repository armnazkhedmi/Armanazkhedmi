rules_version='2';service cloud.firestore{match /databases/{database}/documents{function admin(){return request.auth!=null&&request.auth.token.admin==true;}match /settings/{id}{allow read:if true;allow write:if admin();}match /clinics/{id}{allow read:if true;allow write:if admin();}match /deaths/{id}{allow read:if true;allow write:if admin();}match /users/{id}{allow create:if true;allow read,update,delete:if admin();}}}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if admin();
    }

    match /clinics/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /deaths/{docId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
  }
}